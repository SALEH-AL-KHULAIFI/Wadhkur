<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- الإطار الخارجي -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <solid android:color="#050A12"/>
            <stroke
                android:width="2dp"
                android:color="#39FF8F"/>
        </shape>
    </item>

    <!-- البطاقة الداخلية -->
    <item android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">

        <shape android:shape="rectangle">
            <corners android:radius="21dp"/>
            <solid android:color="#0A1822"/>
            <stroke
                android:width="1dp"
                android:color="#163B47"/>
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp"/>
        </shape>

    </item>

</layer-list>