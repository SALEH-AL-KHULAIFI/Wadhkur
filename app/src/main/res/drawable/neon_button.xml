<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- عند الضغط -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#18B968"/>
            <stroke
                android:width="2dp"
                android:color="#9CFFD0"/>
        </shape>
    </item>

    <!-- الزر العادي -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp"/>
            <solid android:color="#39FF8F"/>
            <stroke
                android:width="2dp"
                android:color="#8AFFBD"/>
        </shape>
    </item>

</selector>