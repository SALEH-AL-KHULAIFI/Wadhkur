<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp"
        android:layoutDirection="rtl">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/header_bg">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/icon_source"
                android:contentDescription="شعار وذكر"
                android:layout_marginBottom="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وذكر"
                android:textColor="@color/green"
                android:textSize="30sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اذكر الله... وطمئن قلبك"
                android:textColor="@color/cyan"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:gravity="center" />

        </LinearLayout>

        <!-- RAMADAN COUNTDOWN IS INSERTED HERE BY MainActivity -->

        <!-- DAILY COUNT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/card_bg">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حصيلة اليوم"
                    android:textColor="@color/cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/countText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/green"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:layout_marginTop="0dp" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="35dp"
                android:background="@color/muted" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ذِكرًا مكتملًا اليوم"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مجموعات الذكر"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="right"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="6dp" />

        <!-- MORNING -->
        <Button
            android:id="@+id/morningBtn"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:text="🌅   أذكار الصباح"
            android:textColor="@color/background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="7dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <!-- EVENING -->
        <Button
            android:id="@+id/eveningBtn"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:text="🌆   أذكار المساء"
            android:textColor="@color/background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="7dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <!-- DUAS -->
        <Button
            android:id="@+id/duasBtn"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:text="🤲   الأدعية"
            android:textColor="@color/background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="7dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <!-- TASBEEH -->
        <Button
            android:id="@+id/tasbeehBtn"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:text="📿   عداد التسبيح"
            android:textColor="@color/background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="7dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <!-- PRAYER TIMES -->
        <Button
            android:id="@+id/prayerBtn"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:text="🕌   مواعيد الصلاة"
            android:textColor="@color/background"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="7dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <!-- REMINDERS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔  تذكيرات الأذكار"
                android:textColor="@color/green"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="right" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="التذكيرات مفعلة"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:gravity="right"
                android:layout_marginTop="3dp" />

            <Button
                android:id="@+id/settingsBtn"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:text="⚙️   الإعدادات"
                android:textColor="@color/background"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/neon_button"
                android:layout_marginTop="8dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

        <!-- ABOUT -->
        <Button
            android:id="@+id/aboutBtn"
            android:layout_width="match_parent"
            android:layout_height="49dp"
            android:text="ℹ️   حول وذكر"
            android:textColor="@color/cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/card_bg"
            android:layout_marginTop="8dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null" />

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وذكر 2.0.0  •  صالح الخليفي"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="10dp" />

    </LinearLayout>

</ScrollView>