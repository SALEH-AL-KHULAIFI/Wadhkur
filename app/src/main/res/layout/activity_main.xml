<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:layoutDirection="rtl">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="22dp"
            android:background="@drawable/header_bg">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:src="@drawable/icon_source"
                android:contentDescription="شعار وذكر"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وذكر"
                android:textColor="@color/green"
                android:textSize="38sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اذكر الله... وطمئن قلبك"
                android:textColor="@color/cyan"
                android:textSize="15sp"
                android:layout_marginTop="4dp"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦  رفيقك اليومي للذكر  ✦"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:gravity="center"/>

        </LinearLayout>

        <!-- RAMADAN COUNTDOWN
             MainActivity adds the live countdown immediately
             below the header. -->

        <!-- DAILY COUNT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="17dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦  حصيلتك اليوم  ✦"
                android:textColor="@color/cyan"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/countText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/green"
                android:textSize="34sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ذِكرًا مكتملًا اليوم"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:layout_marginTop="1dp"/>

        </LinearLayout>

        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مجموعات الذكر"
            android:textColor="@color/white"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="right"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"/>

        <!-- MORNING -->
        <Button
            android:id="@+id/morningBtn"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:text="🌅   أذكار الصباح"
            android:textColor="@color/background"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="10dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <!-- EVENING -->
        <Button
            android:id="@+id/eveningBtn"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:text="🌆   أذكار المساء"
            android:textColor="@color/background"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="10dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <!-- DUAS -->
        <Button
            android:id="@+id/duasBtn"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:text="🤲   الأدعية"
            android:textColor="@color/background"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="10dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <!-- SURAS -->
        <Button
            android:id="@+id/surasBtn"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:text="📖   السور والآيات"
            android:textColor="@color/background"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="10dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <!-- TASBEEH -->
        <Button
            android:id="@+id/tasbeehBtn"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:text="📿   عداد التسبيح"
            android:textColor="@color/background"
            android:textSize="17sp"
            android:textStyle="bold"
            android:background="@drawable/neon_button"
            android:layout_marginBottom="10dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <!-- REMINDERS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔔  رفيق الذكر"
                android:textColor="@color/green"
                android:textSize="21sp"
                android:textStyle="bold"
                android:gravity="right"/>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="التذكيرات متوقفة"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:gravity="right"
                android:layout_marginTop="6dp"/>

            <Button
                android:id="@+id/settingsBtn"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="⚙️   إعداد التذكيرات"
                android:textColor="@color/background"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/neon_button"
                android:layout_marginTop="12dp"
                android:minHeight="0dp"
                android:stateListAnimator="@null"/>

        </LinearLayout>

        <!-- ABOUT -->
        <Button
            android:id="@+id/aboutBtn"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="ℹ️   حول وذكر"
            android:textColor="@color/cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/card_bg"
            android:layout_marginTop="13dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"/>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="وذكر 2.0.0  •  صالح الخليفي"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingTop="20dp"
            android:paddingBottom="18dp"/>

    </LinearLayout>

</ScrollView>